<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>فاتورة مبيعات ذكية - نسخة متطورة</title>
    <style>
        :root {
            --primary: #4f46e5;
            --primary-dark: #4338ca;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --gray: #6b7280;
            --light: #f9fafb;
            --border: #e5e7eb;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Cairo', 'Segoe UI', Tahoma, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: flex-start;
        }

        .container {
            width: 100%;
            max-width: 1200px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.25);
            padding: 30px;
            margin: 20px 0;
        }

        /* رأس الفاتورة */
        .invoice-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 3px solid var(--primary);
        }

        .invoice-title {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .invoice-title .icon {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, var(--primary), #764ba2);
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            color: white;
        }

        .invoice-title h1 {
            font-size: 28px;
            color: #1f2937;
            margin: 0;
        }

        .invoice-title .subtitle {
            color: var(--gray);
            font-size: 14px;
        }

        .invoice-meta {
            text-align: left;
        }

        .invoice-meta p {
            margin: 5px 0;
            color: #374151;
        }

        .invoice-meta .invoice-number {
            font-size: 20px;
            font-weight: bold;
            color: var(--primary);
        }

        /* منطقة الأدوات */
        .toolbar {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 20px;
            padding: 15px;
            background: var(--light);
            border-radius: 12px;
            border: 1px solid var(--border);
        }

        .toolbar input[type="text"] {
            flex: 1;
            min-width: 200px;
            padding: 10px 15px;
            border: 2px solid var(--border);
            border-radius: 8px;
            font-size: 14px;
            transition: all 0.3s;
        }

        .toolbar input[type="text"]:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(79,70,229,0.1);
        }

        /* الأزرار */
        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: bold;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        .btn:active {
            transform: translateY(0);
        }

        .btn-add-row {
            background: var(--primary);
            color: white;
        }

        .btn-add-column {
            background: #3b82f6;
            color: white;
        }

        .btn-reset {
            background: var(--warning);
            color: white;
        }

        .btn-clear {
            background: var(--danger);
            color: white;
        }

        .btn-print {
            background: var(--success);
            color: white;
        }

        .btn-sm {
            padding: 5px 10px;
            font-size: 12px;
            border-radius: 6px;
        }

        /* الجدول */
        .table-wrapper {
            overflow-x: auto;
            border-radius: 12px;
            border: 2px solid var(--border);
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 800px;
        }

        thead {
            background: linear-gradient(135deg, var(--primary), #764ba2);
            color: white;
        }

        th {
            padding: 15px;
            text-align: center;
            font-size: 14px;
            font-weight: bold;
            position: relative;
            border: 1px solid rgba(255,255,255,0.1);
        }

        th .btn-remove-col {
            position: absolute;
            top: -8px;
            right: -8px;
            width: 22px;
            height: 22px;
            background: var(--danger);
            color: white;
            border: 2px solid white;
            border-radius: 50%;
            cursor: pointer;
            font-size: 12px;
            display: none;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
            z-index: 10;
        }

        th:hover .btn-remove-col {
            display: flex;
        }

        td {
            padding: 12px;
            text-align: center;
            border: 1px solid var(--border);
            font-size: 14px;
        }

        tbody tr:nth-child(even) {
            background: #f8fafc;
        }

        tbody tr:hover {
            background: #eef2ff;
        }

        tfoot {
            background: #f3f4f6;
            font-weight: bold;
        }

        tfoot td {
            padding: 15px;
            font-size: 16px;
            border-top: 3px solid var(--primary);
        }

        /* المدخلات */
        input[type="text"],
        input[type="number"] {
            width: 100%;
            padding: 8px 10px;
            border: 1px solid var(--border);
            border-radius: 6px;
            font-size: 14px;
            text-align: center;
            transition: all 0.3s;
            min-width: 80px;
        }

        input[type="text"]:focus,
        input[type="number"]:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(79,70,229,0.1);
        }

        input[readonly] {
            background: #f3f4f6;
            font-weight: bold;
            color: #374151;
        }

        /* ملخص الفاتورة */
        .summary-section {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin: 20px 0;
        }

        .summary-card {
            padding: 20px;
            border-radius: 12px;
            text-align: center;
            transition: all 0.3s;
        }

        .summary-card .label {
            font-size: 13px;
            color: var(--gray);
            margin-bottom: 10px;
            font-weight: bold;
            text-transform: uppercase;
        }

        .summary-card .amount {
            font-size: 24px;
            font-weight: bold;
        }

        .summary-total {
            background: #eef2ff;
            border: 2px solid var(--primary);
        }

        .summary-total .amount {
            color: var(--primary);
        }

        .summary-paid {
            background: #ecfdf5;
            border: 2px solid var(--success);
        }

        .summary-paid .amount {
            color: var(--success);
        }

        .summary-remaining {
            background: #fffbeb;
            border: 2px solid var(--warning);
        }

        .summary-remaining .amount {
            color: var(--warning);
        }

        /* منطقة الدفع */
        .payment-section {
            display: flex;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
            padding: 20px;
            background: linear-gradient(135deg, #f3f4f6, #e5e7eb);
            border-radius: 12px;
            margin: 20px 0;
        }

        .payment-section label {
            font-size: 18px;
            font-weight: bold;
            color: #1f2937;
        }

        .payment-section input {
            flex: 1;
            min-width: 200px;
            padding: 12px 15px;
            font-size: 20px;
            font-weight: bold;
            border: 2px solid var(--primary);
            border-radius: 10px;
            text-align: center;
        }

        /* المتبقي النهائي */
        .final-remaining {
            text-align: center;
            padding: 25px;
            border-radius: 15px;
            margin: 20px 0;
            font-size: 18px;
            font-weight: bold;
            transition: all 0.5s;
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: white;
        }

        .final-remaining.paid {
            background: linear-gradient(135deg, #10b981, #059669);
        }

        .final-remaining .amount {
            font-size: 36px;
            display: block;
            margin-top: 10px;
        }

        /* تحسينات للطباعة */
        @media print {
            body {
                background: white;
                padding: 0;
            }
            .container {
                box-shadow: none;
                border-radius: 0;
                padding: 20px;
            }
            .btn, .toolbar, .btn-remove-col, .btn-remove-row {
                display: none !important;
            }
        }

        /* تحسينات للجوال */
        @media (max-width: 768px) {
            .container {
                padding: 15px;
            }
            .invoice-title h1 {
                font-size: 22px;
            }
            th, td {
                padding: 8px 5px;
                font-size: 12px;
            }
            .summary-card .amount {
                font-size: 18px;
            }
            .btn {
                padding: 8px 15px;
                font-size: 12px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- رأس الفاتورة -->
        <div class="invoice-header">
            <div class="invoice-title">
                <div class="icon">🧾</div>
                <div>
                    <h1>فاتورة مبيعات ذكية</h1>
                    <p class="subtitle">نظام الفوترة المتطور</p>
                </div>
            </div>
            <div class="invoice-meta">
                <p class="invoice-number">INV-2024-001</p>
                <p>التاريخ: <span id="currentDate"></span></p>
                <p>الوقت: <span id="currentTime"></span></p>
            </div>
        </div>

        <!-- شريط الأدوات -->
        <div class="toolbar">
            <input type="text" id="newColumnName" placeholder="✏️ اسم العمود الجديد (مثال: خصم، ضريبة، ملاحظات)">
            <button class="btn btn-add-column" onclick="addCustomColumn()">➕ إضافة عمود</button>
            <button class="btn btn-add-row" onclick="addProductRow()">📦 إضافة صف</button>
            <button class="btn btn-reset" onclick="resetInvoice()">🔄 إعادة تعيين</button>
            <button class="btn btn-clear" onclick="clearInvoice()">🗑️ تصفير الفاتورة</button>
            <button class="btn btn-print" onclick="printInvoice()">🖨️ طباعة</button>
        </div>

        <!-- جدول الفاتورة -->
        <div class="table-wrapper">
            <table id="invoiceTable">
                <thead id="tableHeader">
                    <!-- يتم بناؤه ديناميكياً -->
                </thead>
                <tbody id="tableBody">
                    <!-- يتم بناؤه ديناميكياً -->
                </tbody>
                <tfoot id="tableFooter">
                    <!-- يتم بناؤه ديناميكياً -->
                </tfoot>
            </table>
        </div>

        <!-- ملخص الفاتورة -->
        <div class="summary-section">
            <div class="summary-card summary-total">
                <div class="label">📊 إجمالي الفاتورة</div>
                <div class="amount" id="grandTotal">0</div>
            </div>
            <div class="summary-card summary-paid">
                <div class="label">💰 إجمالي المدفوع</div>
                <div class="amount" id="totalPaid">0</div>
            </div>
            <div class="summary-card summary-remaining">
                <div class="label">⏳ إجمالي المتبقي</div>
                <div class="amount" id="totalRemaining">0</div>
            </div>
        </div>

        <!-- منطقة الدفع -->
        <div class="payment-section">
            <label>💵 المبلغ المدفوع:</label>
            <input type="number" id="paymentInput" min="0" value="0" oninput="calculateAll()">
        </div>

        <!-- المتبقي النهائي -->
        <div class="final-remaining" id="finalRemainingBanner">
            💳 المتبقي النهائي
            <span class="amount" id="finalRemaining">0</span>
        </div>
    </div>

    <script>
        // ============ تعريف المتغيرات والأعمدة ============
        let columns = [
            { id: 'product', name: 'المنتج', type: 'text', required: true },
            { id: 'quantity', name: 'الكمية', type: 'number', required: true },
            { id: 'price', name: 'سعر الوحدة', type: 'number', required: true },
            { id: 'total', name: 'الإجمالي', type: 'calculated', required: true },
            { id: 'paid', name: 'المدفوع', type: 'number', required: true },
            { id: 'remaining', name: 'المتبقي', type: 'calculated', required: true },
            { id: 'actions', name: 'إجراءات', type: 'action', required: true }
        ];

        let rowCount = 0;
        let customColumnCount = 0;

        // ============ دوال التنسيق ============
        function formatNumber(num) {
            return num.toLocaleString('ar-EG', { 
                minimumFractionDigits: 2,
                maximumFractionDigits: 2 
            });
        }

        function parseNumber(str) {
            if (typeof str === 'number') return str;
            return parseFloat(str.replace(/[^0-9.-]/g, '')) || 0;
        }

        // ============ تحديث التاريخ والوقت ============
        function updateDateTime() {
            const now = new Date();
            document.getElementById('currentDate').textContent = now.toLocaleDateString('ar-EG');
            document.getElementById('currentTime').textContent = now.toLocaleTimeString('ar-EG');
        }

        // ============ بناء الجدول ============
        function buildTable() {
            buildHeader();
            buildFooter();
        }

        function buildHeader() {
            const header = document.getElementById('tableHeader');
            let html = '<tr>';
            
            columns.forEach((col, index) => {
                if (col.type === 'action') {
                    html += `<th>${col.name}</th>`;
                } else {
                    const removeBtn = !col.required ? 
                        `<button class="btn-remove-col" onclick="removeColumn(${index})" title="حذف العمود">×</button>` : '';
                    html += `<th>${col.name} ${removeBtn}</th>`;
                }
            });
            
            html += '</tr>';
            header.innerHTML = html;
        }

        function buildFooter() {
            const footer = document.getElementById('tableFooter');
            let html = '<tr>';
            
            columns.forEach((col, index) => {
                if (index === 0) {
                    html += '<td>الإجمالي الكلي</td>';
                } else if (col.id === 'total') {
                    html += '<td id="footerTotal">0</td>';
                } else if (col.id === 'paid') {
                    html += '<td id="footerPaid">0</td>';
                } else if (col.id === 'remaining') {
                    html += '<td id="footerRemaining" style="color: #f59e0b; font-size: 18px;">0</td>';
                } else if (col.type === 'action') {
                    html += '<td>-</td>';
                } else {
                    html += '<td>-</td>';
                }
            });
            
            html += '</tr>';
            footer.innerHTML = html;
        }

        // ============ إضافة صفوف ============
        function addProductRow(data = null) {
            const tbody = document.getElementById('tableBody');
            const row = document.createElement('tr');
            row.id = `row-${rowCount}`;
            
            let html = '';
            
            columns.forEach((col, index) => {
                if (col.type === 'text') {
                    const value = data ? data[col.id] || '' : '';
                    html += `<td><input type="text" class="col-${index}" value="${value}" placeholder="${col.name}"></td>`;
                } else if (col.type === 'number') {
                    const value = data ? data[col.id] || 0 : 0;
                    html += `<td><input type="number" class="col-${index}" min="0" value="${value}" oninput="calculateRow(${rowCount})"></td>`;
                } else if (col.type === 'calculated') {
                    html += `<td><input type="text" class="col-${index}" readonly value="0"></td>`;
                } else if (col.type === 'action') {
                    html += `<td><button class="btn btn-sm" style="background: #ef4444; color: white;" onclick="removeRow(${rowCount})">🗑️ حذف</button></td>`;
                }
            });
            
            row.innerHTML = html;
            tbody.appendChild(row);
            rowCount++;
            
            calculateRow(rowCount - 1);
        }

        function removeRow(rowId) {
            const row = document.getElementById(`row-${rowId}`);
            if (row) {
                row.remove();
                calculateAll();
            }
        }

        // ============ إدارة الأعمدة ============
        function addCustomColumn() {
            const columnName = document.getElementById('newColumnName').value.trim();
            
            if (!columnName) {
                alert('⚠️ الرجاء إدخال اسم العمود أولاً');
                return;
            }
            
            customColumnCount++;
            const newColumn = {
                id: `custom_${customColumnCount}`,
                name: columnName,
                type: 'number',
                required: false
            };
            
            // إضافة العمود قبل عمود الإجراءات
            const actionIndex = columns.findIndex(col => col.type === 'action');
            columns.splice(actionIndex, 0, newColumn);
            
            // إعادة بناء الجدول مع الحفاظ على البيانات
            rebuildTableWithData();
            
            // تنظيف حقل الإدخال
            document.getElementById('newColumnName').value = '';
        }

        function removeColumn(index) {
            if (columns[index].required) {
                alert('⚠️ لا يمكن حذف الأعمدة الأساسية');
                return;
            }
            
            if (confirm(`هل تريد حذف عمود "${columns[index].name}"؟`)) {
                columns.splice(index, 1);
                rebuildTableWithData();
            }
        }

        function rebuildTableWithData() {
            // حفظ البيانات الحالية
            const currentData = [];
            const rows = document.querySelectorAll('#tableBody tr');
            
            rows.forEach(row => {
                const rowData = {};
                columns.forEach((col, index) => {
                    const input = row.querySelector(`.col-${index}`);
                    if (input) {
                        rowData[col.id] = input.value;
                    }
                });
                currentData.push(rowData);
            });
            
            // إعادة بناء الجدول
            buildTable();
            
            // إعادة إضافة الصفوف مع البيانات
            const tbody = document.getElementById('tableBody');
            tbody.innerHTML = '';
            
            currentData.forEach(data => {
                addProductRow(data);
            });
            
            calculateAll();
        }

        // ============ الحسابات ============
        function calculateRow(rowId) {
            const row = document.getElementById(`row-${rowId}`);
            if (!row) return;
            
            let quantityIndex = -1;
            let priceIndex = -1;
            let paidIndex = -1;
            
            columns.forEach((col, index) => {
                if (col.id === 'quantity') quantityIndex = index;
                if (col.id === 'price') priceIndex = index;
                if (col.id === 'paid') paidIndex = index;
            });
            
            if (quantityIndex === -1 || priceIndex === -1) return;
            
            const quantity = parseNumber(row.querySelector(`.col-${quantityIndex}`).value);
            const price = parseNumber(row.querySelector(`.col-${priceIndex}`).value);
            const paid = paidIndex !== -1 ? parseNumber(row.querySelector(`.col-${paidIndex}`).value) : 0;
            
            const total = quantity * price;
            const remaining = Math.max(0, total - paid);
            
            columns.forEach((col, index) => {
                if (col.id === 'total') {
                    const input = row.querySelector(`.col-${index}`);
                    if (input) input.value = formatNumber(total);
                }
                if (col.id === 'remaining') {
                    const input = row.querySelector(`.col-${index}`);
                    if (input) {
                        input.value = formatNumber(remaining);
                        input.style.color = remaining > 0 ? '#f59e0b' : '#10b981';
                    }
                }
            });
            
            calculateAll();
        }

        function calculateAll() {
            const rows = document.querySelectorAll('#tableBody tr');
            let grandTotal = 0;
            let totalPaid = 0;
            let totalRemaining = 0;
            
            rows.forEach(row => {
                columns.forEach((col, index) => {
                    const input = row.querySelector(`.col-${index}`);
                    if (input) {
                        if (col.id === 'total') {
                            grandTotal += parseNumber(input.value);
                        }
                        if (col.id === 'paid') {
                            totalPaid += parseNumber(input.value);
                        }
                        if (col.id === 'remaining') {
                            totalRemaining += parseNumber(input.value);
                        }
                    }
                });
            });
            
            // تحديث التذييل
            const footerTotal = document.getElementById('footerTotal');
            const footerPaid = document.getElementById('footerPaid');
            const footerRemaining = document.getElementById('footerRemaining');
            
            if (footerTotal) footerTotal.textContent = formatNumber(grandTotal);
            if (footerPaid) footerPaid.textContent = formatNumber(totalPaid);
            if (footerRemaining) {
                footerRemaining.textContent = formatNumber(totalRemaining);
                footerRemaining.style.color = totalRemaining > 0 ? '#f59e0b' : '#10b981';
            }
            
            // تحديث الملخص
            document.getElementById('grandTotal').textContent = formatNumber(grandTotal);
            document.getElementById('totalPaid').textContent = formatNumber(totalPaid);
            document.getElementById('totalRemaining').textContent = formatNumber(totalRemaining);
            
            // حساب المتبقي النهائي
            const paymentInput = parseNumber(document.getElementById('paymentInput').value);
            const finalRemaining = Math.max(0, grandTotal - paymentInput);
            
            document.getElementById('finalRemaining').textContent = formatNumber(finalRemaining);
            
            // تحديث لون البانر
            const banner = document.getElementById('finalRemainingBanner');
            if (finalRemaining === 0 && grandTotal > 0) {
                banner.classList.add('paid');
            } else {
                banner.classList.remove('paid');
            }
        }

        // ============ التصفير وإعادة التعيين ============
        function clearInvoice() {
            if (confirm('🗑️ هل تريد تصفير الفاتورة بالكامل؟ سيتم حذف جميع البيانات.')) {
                const tbody = document.getElementById('tableBody');
                tbody.innerHTML = '';
                document.getElementById('paymentInput').value = 0;
                rowCount = 0;
                calculateAll();
            }
        }

        function resetInvoice() {
            if (confirm('🔄 هل تريد إعادة تعيين الفاتورة إلى الوضع الافتراضي؟')) {
                // إعادة تعيين الأعمدة
                columns = [
                    { id: 'product', name: 'المنتج', type: 'text', required: true },
                    { id: 'quantity', name: 'الكمية', type: 'number', required: true },
                    { id: 'price', name: 'سعر الوحدة', type: 'number', required: true },
                    { id: 'total', name: 'الإجمالي', type: 'calculated', required: true },
                    { id: 'paid', name: 'المدفوع', type: 'number', required: true },
                    { id: 'remaining', name: 'المتبقي', type: 'calculated', required: true },
                    { id: 'actions', name: 'إجراءات', type: 'action', required: true }
                ];
                
                customColumnCount = 0;
                rowCount = 0;
                document.getElementById('paymentInput').value = 0;
                
                // إعادة بناء الجدول
                buildTable();
                
                // إضافة صفوف افتراضية
                const tbody = document.getElementById('tableBody');
                tbody.innerHTML = '';
                
                const defaultProducts = [
                    { product: 'لابتوب', quantity: 2, price: 5000, paid: 8000 },
                    { product: 'شاشة', quantity: 3, price: 1500, paid: 3000 },
                    { product: 'طابعة', quantity: 1, price: 2000, paid: 2000 }
                ];
                
                defaultProducts.forEach(product => {
                    addProductRow(product);
                });
                
                calculateAll();
            }
        }

        // ============ الطباعة ============
        function printInvoice() {
            window.print();
        }

        // ============ التهيئة ============
        function initialize() {
            updateDateTime();
            setInterval(updateDateTime, 1000);
            
            buildTable();
            
            // إضافة صفوف افتراضية
            const defaultProducts = [
                { product: 'لابتوب', quantity: 2, price: 5000, paid: 8000 },
                { product: 'شاشة', quantity: 3, price: 1500, paid: 3000 },
                { product: 'طابعة', quantity: 1, price: 2000, paid: 2000 }
            ];
            
            defaultProducts.forEach(product => {
                addProductRow(product);
            });
            
            calculateAll();
        }

        // بدء التشغيل
        initialize();
    </script>
</body>
</html>
