<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>فاتورة مبيعات ذكية</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            text-align: center;
            position: relative;
        }

        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .header .invoice-info {
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 20px;
            font-size: 1.1em;
        }

        .header .info-item {
            background: rgba(255, 255, 255, 0.2);
            padding: 10px 20px;
            border-radius: 10px;
            backdrop-filter: blur(10px);
        }

        .content {
            padding: 30px;
        }

        .customer-info {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
            background: #f8f9fa;
            padding: 20px;
            border-radius: 15px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-group label {
            font-weight: bold;
            margin-bottom: 5px;
            color: #495057;
        }

        .form-group input, .form-group select {
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            font-size: 1em;
            transition: all 0.3s;
        }

        .form-group input:focus, .form-group select:focus {
            border-color: #667eea;
            outline: none;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .table-container {
            overflow-x: auto;
            margin: 20px 0;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            min-width: 1000px;
        }

        th {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px;
            font-weight: bold;
            text-align: center;
            font-size: 0.95em;
        }

        td {
            padding: 12px;
            text-align: center;
            border-bottom: 1px solid #e0e0e0;
        }

        tr:hover {
            background: #f8f9fa;
        }

        input[type="text"], input[type="number"], input[type="date"] {
            width: 100%;
            padding: 10px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 0.95em;
            transition: all 0.3s;
            text-align: center;
        }

        input:focus {
            border-color: #667eea;
            outline: none;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .btn {
            padding: 12px 25px;
            border: none;
            border-radius: 50px;
            font-size: 1em;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
            margin: 5px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .btn-add {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            color: white;
        }

        .btn-add:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(40, 167, 69, 0.3);
        }

        .btn-reset {
            background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
            color: white;
        }

        .btn-reset:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(220, 53, 69, 0.3);
        }

        .btn-delete {
            background: #dc3545;
            color: white;
            padding: 8px 15px;
            font-size: 0.9em;
        }

        .totals {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 20px;
            margin-top: 30px;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 15px;
        }

        .total-item {
            text-align: center;
            padding: 15px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .total-item label {
            display: block;
            font-weight: bold;
            color: #495057;
            margin-bottom: 10px;
            font-size: 0.9em;
        }

        .total-item .value {
            font-size: 1.8em;
            font-weight: bold;
            color: #667eea;
        }

        .total-item .value.remaining {
            color: #dc3545;
        }

        .total-item .value.paid {
            color: #28a745;
        }

        .actions {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 30px;
            flex-wrap: wrap;
        }

        @media (max-width: 768px) {
            .header h1 {
                font-size: 1.8em;
            }
            
            .content {
                padding: 15px;
            }
            
            .btn {
                padding: 10px 20px;
                font-size: 0.9em;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📋 فاتورة مبيعات ذكية</h1>
            <div class="invoice-info">
                <div class="info-item">رقم الفاتورة: <span id="invoiceNumber">INV-2024-001</span></div>
                <div class="info-item">التاريخ: <span id="currentDate"></span></div>
                <div class="info-item">الوقت: <span id="currentTime"></span></div>
            </div>
        </div>

        <div class="content">
            <div class="customer-info">
                <div class="form-group">
                    <label>اسم العميل:</label>
                    <input type="text" id="customerName" placeholder="أدخل اسم العميل">
                </div>
                <div class="form-group">
                    <label>رقم الهاتف:</label>
                    <input type="text" id="customerPhone" placeholder="أدخل رقم الهاتف">
                </div>
                <div class="form-group">
                    <label>البريد الإلكتروني:</label>
                    <input type="email" id="customerEmail" placeholder="أدخل البريد الإلكتروني">
                </div>
                <div class="form-group">
                    <label>طريقة الدفع:</label>
                    <select id="paymentMethod">
                        <option value="cash">نقدي</option>
                        <option value="credit">بطاقة ائتمان</option>
                        <option value="transfer">تحويل بنكي</option>
                        <option value="check">شيك</option>
                    </select>
                </div>
            </div>

            <div class="table-container">
                <table id="invoiceTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>المنتج/الخدمة</th>
                            <th>الكمية</th>
                            <th>السعر</th>
                            <th>الإجمالي</th>
                            <th>المدفوع</th>
                            <th>المتبقي</th>
                            <th>إجراء</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <tr class="invoice-row">
                            <td class="row-number">1</td>
                            <td><input type="text" class="product-name" placeholder="اسم المنتج"></td>
                            <td><input type="number" class="quantity" value="1" min="1" onchange="calculateRow(this)"></td>
                            <td><input type="number" class="price" value="0" min="0" onchange="calculateRow(this)"></td>
                            <td class="row-total">0.00</td>
                            <td><input type="number" class="paid-amount" value="0" min="0" onchange="calculateRow(this)"></td>
                            <td class="row-remaining">0.00</td>
                            <td><button class="btn btn-delete" onclick="deleteRow(this)">🗑️</button></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="totals">
                <div class="total-item">
                    <label>💰 الإجمالي الكلي</label>
                    <div class="value" id="totalAmount">0.00</div>
                </div>
                <div class="total-item">
                    <label>✅ إجمالي المدفوع</label>
                    <div class="value paid" id="totalPaid">0.00</div>
                </div>
                <div class="total-item">
                    <label>⏳ إجمالي المتبقي</label>
                    <div class="value remaining" id="totalRemaining">0.00</div>
                </div>
                <div class="total-item">
                    <label>📊 عدد المنتجات</label>
                    <div class="value" id="productCount">0</div>
                </div>
            </div>

            <div class="actions">
                <button class="btn btn-add" onclick="addRow()">➕ إضافة صف جديد</button>
                <button class="btn btn-reset" onclick="resetInvoice()">🔄 تصفير الفاتورة</button>
                <button class="btn btn-add" onclick="printInvoice()" style="background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);">🖨️ طباعة الفاتورة</button>
            </div>
        </div>
    </div>

    <script>
        // تحديث التاريخ والوقت
        function updateDateTime() {
            const now = new Date();
            document.getElementById('currentDate').textContent = now.toLocaleDateString('ar-SA');
            document.getElementById('currentTime').textContent = now.toLocaleTimeString('ar-SA');
        }
        
        updateDateTime();
        setInterval(updateDateTime, 1000);

        // إضافة صف جديد
        function addRow() {
            const tbody = document.getElementById('tableBody');
            const rows = tbody.getElementsByTagName('tr');
            const newRow = document.createElement('tr');
            newRow.className = 'invoice-row';
            
            newRow.innerHTML = `
                <td class="row-number">${rows.length + 1}</td>
                <td><input type="text" class="product-name" placeholder="اسم المنتج"></td>
                <td><input type="number" class="quantity" value="1" min="1" onchange="calculateRow(this)"></td>
                <td><input type="number" class="price" value="0" min="0" onchange="calculateRow(this)"></td>
                <td class="row-total">0.00</td>
                <td><input type="number" class="paid-amount" value="0" min="0" onchange="calculateRow(this)"></td>
                <td class="row-remaining">0.00</td>
                <td><button class="btn btn-delete" onclick="deleteRow(this)">🗑️</button></td>
            `;
            
            tbody.appendChild(newRow);
            updateRowNumbers();
            calculateAllTotals();
        }

        // حذف صف
        function deleteRow(button) {
            const row = button.closest('tr');
            const tbody = document.getElementById('tableBody');
            
            if (tbody.getElementsByTagName('tr').length > 1) {
                row.remove();
                updateRowNumbers();
                calculateAllTotals();
            } else {
                alert('يجب أن تحتوي الفاتورة على صف واحد على الأقل!');
            }
        }

        // تحديث أرقام الصفوف
        function updateRowNumbers() {
            const rows = document.querySelectorAll('.invoice-row');
            rows.forEach((row, index) => {
                row.querySelector('.row-number').textContent = index + 1;
            });
        }

        // حساب الصف الواحد
        function calculateRow(element) {
            const row = element.closest('tr');
            const quantity = parseFloat(row.querySelector('.quantity').value) || 0;
            const price = parseFloat(row.querySelector('.price').value) || 0;
            const paid = parseFloat(row.querySelector('.paid-amount').value) || 0;
            
            const total = quantity * price;
            const remaining = total - paid;
            
            row.querySelector('.row-total').textContent = total.toFixed(2);
            row.querySelector('.row-remaining').textContent = remaining.toFixed(2);
            
            calculateAllTotals();
        }

        // حساب جميع الإجماليات
        function calculateAllTotals() {
            const rows = document.querySelectorAll('.invoice-row');
            let totalAmount = 0;
            let totalPaid = 0;
            let totalRemaining = 0;
            let productCount = 0;
            
            rows.forEach(row => {
                const quantity = parseFloat(row.querySelector('.quantity').value) || 0;
                const price = parseFloat(row.querySelector('.price').value) || 0;
                const paid = parseFloat(row.querySelector('.paid-amount').value) || 0;
                
                const rowTotal = quantity * price;
                const rowRemaining = rowTotal - paid;
                
                totalAmount += rowTotal;
                totalPaid += paid;
                totalRemaining += rowRemaining;
                productCount += quantity;
            });
            
            document.getElementById('totalAmount').textContent = totalAmount.toFixed(2);
            document.getElementById('totalPaid').textContent = totalPaid.toFixed(2);
            document.getElementById('totalRemaining').textContent = totalRemaining.toFixed(2);
            document.getElementById('productCount').textContent = productCount;
        }

        // تصفير الفاتورة
        function resetInvoice() {
            if (confirm('هل أنت متأكد من تصفير الفاتورة بالكامل؟')) {
                const tbody = document.getElementById('tableBody');
                tbody.innerHTML = `
                    <tr class="invoice-row">
                        <td class="row-number">1</td>
                        <td><input type="text" class="product-name" placeholder="اسم المنتج"></td>
                        <td><input type="number" class="quantity" value="1" min="1" onchange="calculateRow(this)"></td>
                        <td><input type="number" class="price" value="0" min="0" onchange="calculateRow(this)"></td>
                        <td class="row-total">0.00</td>
                        <td><input type="number" class="paid-amount" value="0" min="0" onchange="calculateRow(this)"></td>
                        <td class="row-remaining">0.00</td>
                        <td><button class="btn btn-delete" onclick="deleteRow(this)">🗑️</button></td>
                    </tr>
                `;
                
                document.getElementById('customerName').value = '';
                document.getElementById('customerPhone').value = '';
                document.getElementById('customerEmail').value = '';
                document.getElementById('paymentMethod').value = 'cash';
                
                calculateAllTotals();
            }
        }

        // طباعة الفاتورة
        function printInvoice() {
            window.print();
        }

        // حساب أولي عند التحميل
        calculateAllTotals();
    </script>
</body>
</html>
